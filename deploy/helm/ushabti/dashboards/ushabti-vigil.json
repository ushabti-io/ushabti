{
  "uid": "ushabti-vigil",
  "title": "Ushabti vigil",
  "description": "One ushabti (an agent instance) keeps a vigil (the monitoring loop) over its fields and compares what it sees to Ma'at (the desired state). This board shows what each vigil found and what the weighing (the safety gate) decided.",
  "tags": [
    "ushabti"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "current": {},
        "query": "prometheus"
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "current": {},
        "query": "loki"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(ushabti_vigil_ticks_total, namespace)",
        "query": {
          "query": "label_values(ushabti_vigil_ticks_total, namespace)",
          "refId": "namespace"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1
      },
      {
        "name": "ushabti",
        "label": "Ushabti",
        "type": "query",
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(ushabti_vigil_ticks_total{namespace=~\"$namespace\"}, service)",
        "query": {
          "query": "label_values(ushabti_vigil_ticks_total{namespace=~\"$namespace\"}, service)",
          "refId": "ushabti"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "ushabti on GitHub",
      "type": "link",
      "url": "https://github.com/ushabti-io/ushabti",
      "targetBlank": true,
      "icon": "external",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Each ushabti",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scraped",
      "description": "Whether Prometheus reached /metrics on the last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service) (up{namespace=~\"$namespace\", service=~\"$ushabti\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Halted",
      "description": "Halt is the kill switch. A halted ushabti still observes and raises no summons.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "acting",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "halted",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service) (ushabti_halted{namespace=~\"$namespace\", service=~\"$ushabti\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Since last vigil",
      "description": "Seconds since the last completed vigil tick. Orange at 15 minutes, red at 30.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (service) (ushabti_last_vigil_timestamp_seconds{namespace=~\"$namespace\", service=~\"$ushabti\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Isfet in range",
      "description": "Times an assertion was found broken in the selected time range. Isfet is drift now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (increase(ushabti_isfet_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Omens in range",
      "description": "Times an assertion was predicted to break in the selected time range. An omen is drift coming.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (increase(ushabti_omens_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Vigil ticks in range",
      "description": "Completed vigil ticks in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (increase(ushabti_vigil_ticks_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Ma'at, the desired state",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Assertion status now",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The current Ma'at status of every assertion the vigil checks. in balance holds, omen warns, isfet is broken, unknown means the observation failed or could not be compared.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "status",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "in_balance": {
                        "text": "in balance",
                        "color": "green",
                        "index": 0
                      },
                      "omen": {
                        "text": "omen",
                        "color": "orange",
                        "index": 1
                      },
                      "isfet": {
                        "text": "isfet",
                        "color": "red",
                        "index": 2
                      },
                      "unknown": {
                        "text": "unknown",
                        "color": "text",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service, assertion, status) (ushabti_assertion_status{namespace=~\"$namespace\", service=~\"$ushabti\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "service": 0,
              "assertion": 1,
              "status": 2
            },
            "renameByName": {
              "service": "ushabti"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Isfet and omens per hour",
      "description": "How often the vigil found drift, per hour. Both counters move only on a change of state: a standing problem counts once until it clears.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (increase(ushabti_isfet_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[1h]))",
          "legendFormat": "isfet {{service}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (increase(ushabti_omens_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[1h]))",
          "legendFormat": "omens {{service}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "The weighing, the safety gate",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Verdicts per hour",
      "description": "Every call the model proposed got a verdict: PASS ran, DRY_RUN and NEEDS_APPROVAL were recorded and not run, REJECT was refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (verdict) (increase(ushabti_verdicts_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[1h]))",
          "legendFormat": "{{verdict}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Actions per hour",
      "description": "Implements that ran, by kind. With dry_run on, write stays at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (increase(ushabti_actions_total{namespace=~\"$namespace\", service=~\"$ushabti\"}[1h]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "The feed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "logs",
      "title": "What the vigil said",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The structured log feed: observations, outcomes, summonses, proposals, verdicts, and actions. Needs a Loki datasource; pick it in the loki variable.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{namespace=~\"$namespace\", pod=~\"$ushabti.*\"} | json | event =~ \"isfet|omen|in_balance|summons|proposal|verdict|action|vigil_tick\""
        }
      ]
    }
  ]
}
